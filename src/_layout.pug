doctype html
html(lang="en")
    head
        meta(http-equiv="Content-Type" content="text/html;charset=utf-8")
        meta(name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1")
        meta(http-equiv="x-ua-compatible" content="ie=edge")

        title Vue 2/3 Selectbox Demo

        link(href="demo.css" rel="stylesheet" type="text/css")

        block scripts

        script(src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js" type="text/javascript")
        script(src="vue_selectbox.js" type="text/javascript")

        block app

    body
        block body
            #demo(v-cloak)
                h2 Single Select
                vue_selectbox(:candidates="continents"
                              label="name"
                              v-model="single1"
                              placeholder="Select..."
                              :options="{show_filter_input: false}")
                pre {{single1 || 'null'}}

                h2 Disable options
                vue_selectbox(:candidates="continents"
                              label="name"
                              v-model="single2"
                              placeholder="Select..."
                              :options="{is_selectable: function(item) { return item.name != 'Australia'; }}")
                pre {{single2 || 'null'}}

                h2 Hide some options when no search is performed
                vue_selectbox(:candidates="continents"
                              label="name"
                              v-model="single3"
                              placeholder="Select..."
                              :options="{is_default_candidate: function(item) { return !item.hide_without_search; }}")
                pre {{single3 || 'null'}}

                h2 Multi Select
                vue_selectbox(:candidates="continents"
                              label="name"
                              v-model="multiple"
                              multiple="multiple"
                              placeholder="Select Multiple..."
                              all_label="All Continents"
                              :options="{combine_all: true, allow_deselect_from_list: true}")
                pre {{multiple || '[]'}}

                h2 Add new options
                vue_selectbox(:candidates="continents"
                              label="name"
                              v-on:add="(val) => continents.push(single4 = {name: val})"
                              v-model="single4"
                              placeholder="Select..."
                              :options="{allow_adding: true, close_after_add: false}")
                pre {{single4 || 'null'}}

                h2 Use custom list item markup and custom styles
                vue_selectbox.pretty(:candidates="continents"
                                     label="name"
                                     v-model="single4"
                                     placeholder="Select...")
                    template(#selected="{item}")
                        | {{item.name}} ({{item.hemisphere}})
                    template(#candidate="{item}")
                        | {{item.hemisphere}}: #[strong {{item.name}}]
                pre {{single4 || 'null'}}

                h2 Disabled Select
                vue_selectbox(:candidates="continents"
                              label="name"
                              v-model="multiple"
                              :multiple="true"
                              placeholder="Select..."
                              :disabled="true")

